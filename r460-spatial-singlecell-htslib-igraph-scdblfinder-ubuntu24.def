Bootstrap: docker
From: ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

%labels
    org.opencontainers.image.title "R spatial, single-cell, doublet, graph, and HTS analysis"
    org.opencontainers.image.description "Ubuntu 24.04 LTS, R 4.6.0, Seurat 5.5.0, glmGamPoi 1.24.0, scDblFinder 1.26.7, Rhtslib 3.8.0, system igraph 0.10.10, system HTSlib 1.19, Arrow 24.0.0, and pinned dependencies"
    org.opencontainers.image.version "r4.6.0-seurat5.5.0-glmGamPoi1.24.0-Rhtslib3.8.0-scDblFinder1.26.7"
    org.opencontainers.image.base.name "docker.io/library/ubuntu:24.04"
    org.opencontainers.image.base.digest "sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90"
    org.opencontainers.image.architecture "amd64"
    org.r-project.version "4.6.0"
    org.r-project.cran-snapshot "2026-06-01"
    org.bioconductor.version "3.23"
    org.bioconductor.glmGamPoi.version "1.24.0"
    org.bioconductor.Rhtslib.version "3.8.0"
    org.bioconductor.scDblFinder.version "1.26.7"
    org.system.igraph.version "0.10.10"
    org.system.htslib.version "1.19"

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl

    curl -fL --retry 5 --retry-delay 5 \
        -o /tmp/apache-arrow-apt-source_24.0.0-1_all.deb \
        https://packages.apache.org/artifactory/arrow/ubuntu/pool/noble/main/a/apache-arrow-apt-source/apache-arrow-apt-source_24.0.0-1_all.deb
    printf '%s  %s\n' \
        'e95437b98562d18bdf56ce87eed4d8a465ca8aeb5bd15800e1ffa430f6f139ac' \
        '/tmp/apache-arrow-apt-source_24.0.0-1_all.deb' | sha256sum -c -
    apt-get install -y --no-install-recommends \
        /tmp/apache-arrow-apt-source_24.0.0-1_all.deb
    printf '%s\n' \
        'Package: libarrow* libparquet*' \
        'Pin: version 24.0.0-1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/apache-arrow-24
    apt-get update

    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        file \
        g++-12 \
        gcc-12 \
        gfortran-13 \
        git \
        libblas-dev \
        libbz2-dev \
        libcairo2-dev \
        libcurl4-gnutls-dev \
        libdeflate-dev \
        libfftw3-dev \
        libfontconfig1-dev \
        libfreetype-dev \
        libfribidi-dev \
        libgdal-dev \
        libgeos-dev \
        libgfortran-13-dev \
        libgit2-dev \
        libglpk-dev \
        libgmp-dev \
        libgsl-dev \
        libharfbuzz-dev \
        libhdf5-dev \
        libhts-dev=1.19+ds-1.1build3 \
        libhts3t64=1.19+ds-1.1build3 \
        libicu-dev \
        libicu74 \
        libigraph-dev=0.10.10+ds-1.1build2 \
        libigraph3t64=0.10.10+ds-1.1build2 \
        libjpeg-dev \
        liblapack-dev \
        liblzma-dev \
        libnghttp2-dev \
        libpango1.0-dev \
        libpcre2-dev \
        libpng-dev \
        libproj-dev \
        libreadline-dev \
        libsqlite3-dev \
        libssl-dev \
        libtiff-dev \
        libtool \
        libudunits2-dev \
        libuv1-dev \
        libx11-dev \
        libxml2-dev \
        libxt-dev \
        libarrow-dev=24.0.0-1 \
        libarrow-dataset-dev=24.0.0-1 \
        libarrow-acero-dev=24.0.0-1 \
        libarrow-flight-dev=24.0.0-1 \
        libparquet-dev=24.0.0-1 \
        make \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
        unzip \
        wget \
        xz-utils \
        zip \
        zlib1g-dev \
        gdal-bin

    for package in \
        libarrow-dev \
        libarrow-dataset-dev \
        libarrow-acero-dev \
        libarrow-flight-dev \
        libparquet-dev
    do
        test "$(dpkg-query -W -f='${Version}' "$package")" = '24.0.0-1'
    done

    test "$(dpkg-query -W -f='${Version}' libigraph-dev)" \
        = '0.10.10+ds-1.1build2'
    test "$(dpkg-query -W -f='${Version}' libigraph3t64)" \
        = '0.10.10+ds-1.1build2'
    test "$(dpkg-query -W -f='${Version}' libhts-dev)" \
        = '1.19+ds-1.1build3'
    test "$(dpkg-query -W -f='${Version}' libhts3t64)" \
        = '1.19+ds-1.1build3'
    dpkg-query -W -f='${Status}\n' libcurl4-gnutls-dev \
        | grep -Fx 'install ok installed'
    dpkg --audit

    mkdir -p \
        /opt/src \
        /opt/R/4.6.0 \
        /opt/R/site-library \
        /opt/container \
        /opt/container-metadata/arrow-build-logs

    cd /opt/src
    curl -fL --retry 5 --retry-delay 5 \
        -o R-4.6.0.tar.xz \
        https://cran.r-project.org/src/base/R-4/R-4.6.0.tar.xz
    printf '%s  %s\n' \
        '91f2b3693fa5252cdea9b62abc84a1c58db5547cb9f0fe3d15f44eef8aff5a27' \
        'R-4.6.0.tar.xz' | sha256sum -c -
    tar -xf R-4.6.0.tar.xz

    curl -fL --retry 5 --retry-delay 5 \
        -o glmGamPoi_1.24.0.tar.gz \
        https://bioconductor.org/packages/3.23/bioc/src/contrib/glmGamPoi_1.24.0.tar.gz
    printf '%s  %s\n' \
        'faf17f91e8e84a6cb455c7588df352f24da2f5a07e7d4ab8a3b654889a1e7492' \
        'glmGamPoi_1.24.0.tar.gz' | tee \
        /opt/container-metadata/glmGamPoi-source.sha256 | sha256sum -c -

    curl -fL --retry 5 --retry-delay 5 \
        -o Rhtslib_3.8.0.tar.gz \
        https://bioconductor.org/packages/3.23/bioc/src/contrib/Rhtslib_3.8.0.tar.gz
    printf '%s  %s\n' \
        'e89153bbac580adc2e988a095ce39c26e28cdf23b9a337988d18f66bc3b1eded' \
        'Rhtslib_3.8.0.tar.gz' | tee \
        /opt/container-metadata/Rhtslib-source.sha256 | sha256sum -c -

    curl -fL --retry 5 --retry-delay 5 \
        -o scDblFinder_1.26.7.tar.gz \
        https://bioconductor.org/packages/3.23/bioc/src/contrib/scDblFinder_1.26.7.tar.gz
    printf '%s  %s\n' \
        '429b753d97cceac442e9435a773732f8c068eed45518b6ce75b6f944d9aee059' \
        'scDblFinder_1.26.7.tar.gz' | tee \
        /opt/container-metadata/scDblFinder-source.sha256 | sha256sum -c -

    cd /opt/src/R-4.6.0
    CC=gcc-12 \
    CXX=g++-12 \
    CXX11=g++-12 \
    CXX14=g++-12 \
    CXX17=g++-12 \
    CXX20=g++-12 \
    FC=gfortran-13 \
    F77=gfortran-13 \
    CFLAGS='-O2 -pipe' \
    CXXFLAGS='-O2 -pipe' \
    FCFLAGS='-O2 -pipe' \
    FFLAGS='-O2 -pipe' \
        /bin/bash ./configure \
            --prefix=/opt/R/4.6.0 \
            --enable-R-shlib \
            --with-blas \
            --with-lapack \
            --with-x
    make -j2
    make install

    ln -sf /opt/R/4.6.0/bin/R /usr/local/bin/R
    ln -sf /opt/R/4.6.0/bin/Rscript /usr/local/bin/Rscript

    cat > /opt/container/install-r-packages.R <<'RSCRIPT'
    cran_repo <- "https://packagemanager.posit.co/cran/2026-06-01"
    options(
      repos = c(CRAN = cran_repo),
      timeout = 1800,
      Ncpus = 2L,
      warn = 1
    )

    lib <- "/opt/R/site-library"
    dir.create(lib, recursive = TRUE, showWarnings = FALSE)
    .libPaths(c(lib, .libPaths()))

    non_arrow <- c(
      "tidyverse",
      "future",
      "sp",
      "dplyr",
      "ggplot2",
      "SeuratObject",
      "Seurat",
      "hdf5r",
      "sf",
      "BiocManager"
    )

    install.packages(
      non_arrow,
      lib = lib,
      type = "source",
      dependencies = NA,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    Sys.setenv(
      LIBARROW_BINARY = "false",
      LIBARROW_BUILD = "false",
      ARROW_USE_PKG_CONFIG = "true",
      ARROW_R_DEV = "true",
      PKG_CONFIG_PATH = "/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig",
      CMAKE_BUILD_PARALLEL_LEVEL = "2",
      MAKEFLAGS = "-j2"
    )

    install.packages(
      "arrow",
      lib = lib,
      type = "source",
      dependencies = NA,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    bioc_repos <- BiocManager::repositories(version = "3.23")
    bioc_repos[["CRAN"]] <- cran_repo
    options(repos = bioc_repos)

    install.packages(
      "/opt/src/Rhtslib_3.8.0.tar.gz",
      lib = lib,
      repos = NULL,
      type = "source",
      dependencies = FALSE,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    BiocManager::install(
      c("glmGamPoi", "scDblFinder"),
      lib = lib,
      version = "3.23",
      ask = FALSE,
      update = FALSE,
      dependencies = NA,
      type = "source",
      Ncpus = 2L,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    install.packages(
      "/opt/src/glmGamPoi_1.24.0.tar.gz",
      lib = lib,
      repos = NULL,
      type = "source",
      dependencies = FALSE,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    install.packages(
      "/opt/src/scDblFinder_1.26.7.tar.gz",
      lib = lib,
      repos = NULL,
      type = "source",
      dependencies = FALSE,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    expected <- c(
      tidyverse = "2.0.0",
      sf = "1.1-1",
      arrow = "24.0.0",
      hdf5r = "1.3.12",
      ggplot2 = "4.0.3",
      Seurat = "5.5.0",
      SeuratObject = "5.4.0",
      sp = "2.2-1",
      dplyr = "1.2.1",
      future = "1.70.0",
      glmGamPoi = "1.24.0",
      Rhtslib = "3.8.0",
      scDblFinder = "1.26.7",
      igraph = "2.3.2"
    )

    stopifnot(
      as.character(getRversion()) == "4.6.0",
      as.character(BiocManager::version()) == "3.23"
    )
    actual <- vapply(names(expected), function(pkg) {
      as.character(utils::packageDescription(
        pkg,
        lib.loc = lib,
        fields = "Version"
      ))
    }, character(1))

    if (!identical(unname(actual), unname(expected))) {
      print(data.frame(package = names(expected), expected, actual))
      stop("Top-level R package version gate failed")
    }

    installed <- as.data.frame(installed.packages(), stringsAsFactors = FALSE)
    installed <- installed[order(installed$Package), , drop = FALSE]
    write.table(
      installed,
      file = "/opt/container-metadata/r-packages.tsv",
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )
    writeLines(
      c(
        paste("Bioconductor", as.character(BiocManager::version())),
        paste(names(bioc_repos), unname(bioc_repos), sep = "\t")
      ),
      "/opt/container-metadata/bioconductor-repositories.txt"
    )
    capture.output(sessionInfo(), file = "/opt/container-metadata/r-session-info.txt")
RSCRIPT

    export PATH=/opt/R/4.6.0/bin:/usr/local/bin:/usr/bin:/bin
    export R_HOME=/opt/R/4.6.0/lib/R
    export R_LIBS_SITE=/opt/R/site-library
    export R_LIBS_USER=
    export MAKEFLAGS=-j2
    /opt/R/4.6.0/bin/Rscript --vanilla /opt/container/install-r-packages.R

    cat > /opt/container/validate-system-libs.sh <<'SHELLSCRIPT'
    #!/bin/sh
    set -eu

    require_package_version() {
        package="$1"
        expected="$2"
        actual="$(dpkg-query -W -f='${Version}' "$package")"
        test "$actual" = "$expected"
    }

    require_package_version libigraph-dev '0.10.10+ds-1.1build2'
    require_package_version libigraph3t64 '0.10.10+ds-1.1build2'
    require_package_version libhts-dev '1.19+ds-1.1build3'
    require_package_version libhts3t64 '1.19+ds-1.1build3'
    dpkg --audit

    for package in \
        libcurl4-gnutls-dev \
        libdeflate-dev \
        libglpk-dev \
        libxml2-dev
    do
        dpkg-query -W -f='${Status}\n' "$package" \
            | grep -Fx 'install ok installed' >/dev/null
    done

    test "$(pkg-config --modversion igraph)" = '0.10.10'
    test "$(pkg-config --modversion htslib)" = '1.19'
    test -f "$(pkg-config --variable=includedir igraph)/igraph/igraph.h"
    test -f "$(pkg-config --variable=includedir htslib)/htslib/hts.h"

    test_dir="$(mktemp -d)"
    trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

    cat > "$test_dir/igraph-smoke.c" <<'CSOURCE'
    #include <igraph/igraph.h>

    int main(void)
    {
        igraph_t graph;
        if (igraph_ring(&graph, 5, IGRAPH_UNDIRECTED, 0, 1) != IGRAPH_SUCCESS)
            return 1;
        if (igraph_vcount(&graph) != 5 || igraph_ecount(&graph) != 5) {
            igraph_destroy(&graph);
            return 2;
        }
        igraph_destroy(&graph);
        return 0;
    }
CSOURCE

    gcc-12 -O2 -pipe \
        "$test_dir/igraph-smoke.c" \
        $(pkg-config --cflags --libs igraph) \
        -o "$test_dir/igraph-smoke"
    "$test_dir/igraph-smoke"
    ldd "$test_dir/igraph-smoke" | grep -F 'libigraph.so.3' >/dev/null
    if ldd "$test_dir/igraph-smoke" | grep -F 'not found'; then
        exit 1
    fi

    cat > "$test_dir/htslib-smoke.c" <<'CSOURCE'
    #include <htslib/hts.h>
    #include <stdio.h>
    #include <string.h>

    int main(void)
    {
        const char *version = hts_version();
        puts(version);
        return strcmp(version, "1.19") != 0;
    }
CSOURCE

    gcc-12 -O2 -pipe \
        "$test_dir/htslib-smoke.c" \
        $(pkg-config --cflags --libs htslib) \
        -o "$test_dir/htslib-smoke"
    "$test_dir/htslib-smoke"
    ldd "$test_dir/htslib-smoke" | grep -F 'libhts.so.3' >/dev/null
    if ldd "$test_dir/htslib-smoke" | grep -F 'not found'; then
        exit 1
    fi

    printf '%s\n' \
        'System igraph 0.10.10 compile/link/runtime check passed.' \
        'System HTSlib 1.19 compile/link/runtime check passed.'
SHELLSCRIPT

    cat > /opt/container/validate.R <<'RSCRIPT'
    options(warn = 1)
    .libPaths(c("/opt/R/site-library", .libPaths()))

    expected <- c(
      tidyverse = "2.0.0",
      sf = "1.1-1",
      arrow = "24.0.0",
      hdf5r = "1.3.12",
      ggplot2 = "4.0.3",
      Seurat = "5.5.0",
      SeuratObject = "5.4.0",
      sp = "2.2-1",
      dplyr = "1.2.1",
      future = "1.70.0",
      glmGamPoi = "1.24.0",
      Rhtslib = "3.8.0",
      scDblFinder = "1.26.7",
      igraph = "2.3.2"
    )

    stopifnot(
      as.character(getRversion()) == "4.6.0",
      as.character(BiocManager::version()) == "3.23"
    )
    actual <- vapply(names(expected), function(pkg) {
      as.character(utils::packageDescription(pkg, fields = "Version"))
    }, character(1))
    stopifnot(identical(unname(actual), unname(expected)))

    suppressPackageStartupMessages({
      library(sf)
      library(arrow)
      library(hdf5r)
      library(ggplot2)
      library(Seurat)
      library(future)
      library(dplyr)
      library(glmGamPoi)
      library(Rhtslib)
      library(scDblFinder)
      library(Matrix)
      library(HDF5Array)
      library(BiocParallel)
      library(Rsamtools)
      library(igraph)
    })

    point <- sf::st_sfc(sf::st_point(c(-75, 40)), crs = 4326)
    projected <- sf::st_transform(point, 3857)
    stopifnot(all(is.finite(sf::st_coordinates(projected))))

    parquet_file <- tempfile(fileext = ".parquet")
    arrow::write_parquet(
      data.frame(group = c("a", "a", "b"), value = 1:3),
      parquet_file
    )
    parquet_roundtrip <- as.data.frame(arrow::read_parquet(parquet_file))
    stopifnot(nrow(parquet_roundtrip) == 3L, sum(parquet_roundtrip$value) == 6)
    dataset_result <- arrow::open_dataset(parquet_file) |>
      dplyr::group_by(group) |>
      dplyr::summarise(total = sum(value)) |>
      dplyr::collect()
    stopifnot(sum(dataset_result$total) == 6)
    unlink(parquet_file)

    h5_file <- tempfile(fileext = ".h5")
    h5 <- hdf5r::H5File$new(h5_file, mode = "w")
    h5[["values"]] <- as.integer(1:5)
    h5_values <- h5[["values"]][]
    h5$close_all()
    stopifnot(identical(as.integer(h5_values), 1:5))
    unlink(h5_file)

    plot_file <- tempfile(fileext = ".png")
    plot_object <- ggplot2::ggplot(
      data.frame(x = 1:3, y = c(1, 4, 2)),
      ggplot2::aes(x, y)
    ) + ggplot2::geom_line()
    ggplot2::ggsave(plot_file, plot_object, width = 4, height = 3, dpi = 72)
    stopifnot(file.exists(plot_file), file.info(plot_file)$size > 0)
    unlink(plot_file)

    set.seed(1)
    counts <- matrix(stats::rpois(40 * 20, lambda = 5), nrow = 40, ncol = 20)
    rownames(counts) <- sprintf("gene_%02d", seq_len(nrow(counts)))
    colnames(counts) <- sprintf("cell_%02d", seq_len(ncol(counts)))
    object <- Seurat::CreateSeuratObject(counts = counts)
    object <- Seurat::NormalizeData(object, verbose = FALSE)
    object <- Seurat::FindVariableFeatures(object, nfeatures = 20, verbose = FALSE)
    object <- Seurat::ScaleData(
      object,
      features = Seurat::VariableFeatures(object),
      verbose = FALSE
    )
    object <- Seurat::RunPCA(
      object,
      features = Seurat::VariableFeatures(object),
      npcs = 5,
      verbose = FALSE
    )
    stopifnot(ncol(Seurat::Embeddings(object, reduction = "pca")) == 5L)

    previous_plan <- future::plan(future::sequential)
    result <- future::value(future::future(40 + 2))
    future::plan(previous_plan)
    stopifnot(identical(result, 42))

    set.seed(20260724)
    condition <- factor(rep(c("control", "treated"), each = 20))
    mu <- outer(
      seq(0.8, 12, length.out = 48),
      ifelse(condition == "treated", 1.8, 1)
    )
    gp_counts <- matrix(
      stats::rnbinom(length(mu), mu = as.vector(mu), size = 4),
      nrow = nrow(mu)
    )
    zero_rows <- which(rowSums(gp_counts) == 0)
    if (length(zero_rows)) {
      gp_counts[cbind(zero_rows, rep(1L, length(zero_rows)))] <- 1L
    }
    design <- stats::model.matrix(~ condition)

    fit_dense <- glmGamPoi::glm_gp(
      gp_counts,
      design = design,
      size_factors = FALSE,
      overdispersion_shrinkage = FALSE,
      on_disk = FALSE
    )

    gp_counts_sparse <- methods::as(
      Matrix::Matrix(gp_counts, sparse = TRUE),
      "dgCMatrix"
    )
    fit_sparse <- glmGamPoi::glm_gp(
      gp_counts_sparse,
      design = design,
      size_factors = FALSE,
      overdispersion_shrinkage = FALSE,
      on_disk = FALSE
    )

    gp_h5_file <- tempfile(fileext = ".h5")
    gp_counts_h5 <- HDF5Array::writeHDF5Array(
      gp_counts,
      filepath = gp_h5_file,
      name = "counts"
    )
    fit_disk <- glmGamPoi::glm_gp(
      gp_counts_h5,
      design = design,
      size_factors = FALSE,
      overdispersion_shrinkage = FALSE,
      on_disk = TRUE
    )

    check_gp_fit <- function(x) {
      stopifnot(
        inherits(x, "glmGamPoi") || inherits(x, "glmGamPoiFit"),
        identical(dim(x$Beta), c(nrow(gp_counts), ncol(design))),
        identical(dim(x$Mu), dim(gp_counts)),
        all(is.finite(x$Beta)),
        all(is.finite(x$overdispersions)),
        all(x$overdispersions >= 0)
      )
    }
    invisible(lapply(list(fit_dense, fit_sparse, fit_disk), check_gp_fit))
    stopifnot(
      inherits(fit_disk$Mu, "HDF5Matrix"),
      isTRUE(all.equal(
        fit_dense$Beta,
        fit_sparse$Beta,
        tolerance = 1e-6,
        check.attributes = FALSE
      )),
      isTRUE(all.equal(
        fit_dense$Beta,
        fit_disk$Beta,
        tolerance = 1e-6,
        check.attributes = FALSE
      ))
    )
    unlink(gp_h5_file)

    set.seed(20260724)
    sct_mu <- outer(seq(0.5, 18, length.out = 300), rep(1, 80))
    sct_counts <- matrix(
      stats::rnbinom(length(sct_mu), mu = as.vector(sct_mu), size = 5),
      nrow = nrow(sct_mu)
    )
    rownames(sct_counts) <- sprintf("sct_gene_%03d", seq_len(nrow(sct_counts)))
    colnames(sct_counts) <- sprintf("sct_cell_%03d", seq_len(ncol(sct_counts)))
    sct_zero_rows <- which(rowSums(sct_counts) == 0)
    if (length(sct_zero_rows)) {
      sct_counts[cbind(
        sct_zero_rows,
        rep(1L, length(sct_zero_rows))
      )] <- 1L
    }
    vst_fit <- sctransform::vst(
      sct_counts,
      method = "glmGamPoi",
      n_genes = 200,
      n_cells = 80,
      verbosity = 0
    )
    stopifnot(
      is.list(vst_fit),
      identical(vst_fit$arguments$method, "glmGamPoi"),
      nrow(vst_fit$y) > 0,
      ncol(vst_fit$y) == 80
    )

    stopifnot(isTRUE(capabilities("libcurl")))
    curl_info <- curl::curl_version()
    stopifnot(
      nzchar(curl_info$version),
      nzchar(curl_info$ssl_version)
    )

    r_graph <- igraph::make_ring(5, directed = FALSE)
    stopifnot(
      igraph::vcount(r_graph) == 5,
      igraph::ecount(r_graph) == 5,
      igraph::is_connected(r_graph)
    )

    bundled_htslib_version <- .Call(
      "Rhtslib_htslib_version",
      PACKAGE = "Rhtslib"
    )
    rhtslib_include <- system.file("include", package = "Rhtslib")
    rhtslib_usrlib <- system.file("usrlib", package = "Rhtslib")
    stopifnot(
      identical(bundled_htslib_version, "1.18"),
      file.exists(file.path(rhtslib_include, "htslib", "hts.h")),
      file.exists(file.path(rhtslib_usrlib, "libhts.a")),
      file.exists(file.path(rhtslib_usrlib, "libhts.so"))
    )

    sam_file <- tempfile(fileext = ".sam")
    writeLines(
      c(
        "@HD\tVN:1.6\tSO:unsorted",
        "@SQ\tSN:chr1\tLN:100",
        "read1\t0\tchr1\t1\t60\t4M\t*\t0\t0\tACGT\tIIII"
      ),
      sam_file
    )
    bam_file <- Rsamtools::asBam(
      sam_file,
      destination = tempfile("rhtslib-smoke"),
      overwrite = TRUE
    )
    bam_count <- Rsamtools::countBam(bam_file)
    bam_header <- Rsamtools::scanBamHeader(bam_file)
    stopifnot(
      identical(as.integer(bam_count$records), 1L),
      "chr1" %in% names(bam_header[[1]]$targets)
    )
    unlink(c(sam_file, bam_file, paste0(bam_file, ".bai")))

    set.seed(123)
    doublet_sce <- scDblFinder::mockDoubletSCE(
      ncells = c(A = 100L, B = 200L, C = 150L, D = 100L),
      ngenes = 250L,
      dbl.rate = 0.10
    )
    doublet_sce$test_cluster <- scDblFinder::fastcluster(
      doublet_sce,
      nfeatures = 100L,
      verbose = FALSE
    )
    doublet_sce <- scDblFinder::scDblFinder(
      doublet_sce,
      clusters = "test_cluster",
      artificialDoublets = 250L,
      dbr = 0.10,
      verbose = FALSE,
      BPPARAM = BiocParallel::SerialParam(RNGseed = 123)
    )
    doublet_score <- doublet_sce$scDblFinder.score
    doublet_call <- as.character(doublet_sce$scDblFinder.class)
    doublet_truth <- as.character(doublet_sce$type)
    doublet_accuracy <- mean(doublet_call == doublet_truth)
    stopifnot(
      length(doublet_score) == ncol(doublet_sce),
      all(is.finite(doublet_score)),
      all(doublet_score >= 0 & doublet_score <= 1),
      all(doublet_call %in% c("singlet", "doublet")),
      all(c("singlet", "doublet") %in% doublet_call),
      doublet_accuracy > 0.80,
      unname(median(doublet_score[doublet_truth == "doublet"])) >
        unname(median(doublet_score[doublet_truth == "singlet"]))
    )

    cat("Validated OS:\n")
    cat(readLines("/etc/os-release"), sep = "\n")
    cat("\nValidated R, Bioconductor, and top-level package versions:\n")
    cat("Bioconductor:", as.character(BiocManager::version()), "\n")
    print(data.frame(package = names(expected), version = actual), row.names = FALSE)
    cat("\nsf external libraries:\n")
    print(sf::sf_extSoftVersion())
    cat("\nHDF5 version:\n")
    print(hdf5r::h5version())
    cat("\nArrow build information:\n")
    print(arrow::arrow_info())
    cat("\nglmGamPoi dense, sparse, HDF5-backed, and sctransform checks passed.\n")
    cat("\nSystem-compatible R libcurl backend:", curl_info$ssl_version, "\n")
    cat("R igraph graph operation passed.\n")
    cat("Rhtslib bundled HTSlib version:", bundled_htslib_version, "\n")
    cat("Rsamtools SAM-to-BAM round-trip passed.\n")
    cat(
      "scDblFinder functional validation passed; accuracy=",
      format(doublet_accuracy, digits = 4),
      "\n",
      sep = ""
    )
    cat("\nAll container validation checks passed.\n")
RSCRIPT

    chmod 0555 \
        /opt/container/install-r-packages.R \
        /opt/container/validate-system-libs.sh \
        /opt/container/validate.R

    dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort \
        > /opt/container-metadata/debian-packages.tsv
    {
        printf 'R: '
        /opt/R/4.6.0/bin/R --version | head -n 1
        printf 'Bioconductor: '
        Rscript --vanilla -e 'cat(as.character(BiocManager::version()), "\n")'
        printf 'glmGamPoi: '
        Rscript --vanilla -e \
            'cat(utils::packageDescription("glmGamPoi", fields="Version"), "\n")'
        printf 'Rhtslib: '
        Rscript --vanilla -e \
            'cat(utils::packageDescription("Rhtslib", fields="Version"), "\n")'
        printf 'Rhtslib-bundled-htslib: '
        Rscript --vanilla -e \
            'cat(.Call("Rhtslib_htslib_version", PACKAGE="Rhtslib"), "\n")'
        printf 'scDblFinder: '
        Rscript --vanilla -e \
            'cat(utils::packageDescription("scDblFinder", fields="Version"), "\n")'
        printf 'r-igraph: '
        Rscript --vanilla -e \
            'cat(utils::packageDescription("igraph", fields="Version"), "\n")'
        printf 'gcc: '
        gcc-12 --version | head -n 1
        printf 'g++: '
        g++-12 --version | head -n 1
        printf 'gfortran: '
        gfortran-13 --version | head -n 1
        printf 'python: '
        python3 --version
        printf 'fftw: '
        pkg-config --modversion fftw3
        printf 'hdf5: '
        pkg-config --modversion hdf5
        printf 'arrow-cpp: '
        pkg-config --modversion arrow
        printf 'parquet-cpp: '
        pkg-config --modversion parquet
        printf 'gdal: '
        gdal-config --version
        printf 'geos: '
        geos-config --version
        printf 'proj: '
        pkg-config --modversion proj
        printf 'system-igraph: '
        pkg-config --modversion igraph
        printf 'system-htslib: '
        pkg-config --modversion htslib
        printf 'libigraph-dev-deb: '
        dpkg-query -W -f='${Version}\n' libigraph-dev
        printf 'libigraph-runtime-deb: '
        dpkg-query -W -f='${Version}\n' libigraph3t64
        printf 'libhts-dev-deb: '
        dpkg-query -W -f='${Version}\n' libhts-dev
        printf 'libhts-runtime-deb: '
        dpkg-query -W -f='${Version}\n' libhts3t64
        printf 'libcurl-development-backend: '
        dpkg-query -W -f='${binary:Package} ${Version}\n' libcurl4-gnutls-dev
    } > /opt/container-metadata/toolchain-versions.txt

    /opt/container/validate-system-libs.sh \
        > /opt/container-metadata/system-library-validation.txt 2>&1

    R_LIBS_SITE=/opt/R/site-library \
        /opt/R/4.6.0/bin/Rscript --vanilla /opt/container/validate.R \
        > /opt/container-metadata/build-validation.txt 2>&1

    apt-get clean
    find /var/lib/apt/lists -type f -delete
    find /opt/src -mindepth 1 -delete

%environment
    export PATH=/opt/R/4.6.0/bin:/usr/local/bin:/usr/bin:/bin
    export R_HOME=/opt/R/4.6.0/lib/R
    export R_LIBS_SITE=/opt/R/site-library
    export R_LIBS_USER=
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export R_MAX_NUM_DLLS=1000
    export PYTHONNOUSERSITE=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export CC=gcc-12
    export CXX=g++-12
    export FC=gfortran-13
    export F77=gfortran-13

%runscript
    exec /opt/R/4.6.0/bin/R "$@"

%test
    set -eu
    export R_HOME=/opt/R/4.6.0/lib/R
    export R_LIBS_SITE=/opt/R/site-library
    export R_LIBS_USER=
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export R_MAX_NUM_DLLS=1000
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    /opt/container/validate-system-libs.sh
    /opt/R/4.6.0/bin/Rscript --vanilla /opt/container/validate.R

%help
    This amd64 image contains Ubuntu 24.04 LTS, R 4.6.0, Bioconductor
    3.23, glmGamPoi 1.24.0, Rhtslib 3.8.0, scDblFinder 1.26.7,
    system igraph 0.10.10, system HTSlib 1.19, and the complete pinned
    spatial/single-cell R stack requested for PMACS.

    Ubuntu 24.04 names the runtime packages libigraph3t64 and
    libhts3t64; these provide the requested libigraph3 and libhts3
    ABIs and the libigraph.so.3 and libhts.so.3 shared libraries.

    Rhtslib contains a separate private HTSlib 1.18 library for R
    packages. The system HTSlib 1.19 and Rhtslib HTSlib 1.18 have both
    passed independent functional tests.

    Validate:
      singularity test --cleanenv IMAGE.sif

    Run an R script:
      singularity exec --cleanenv IMAGE.sif Rscript analysis.R

    Start R:
      singularity run --cleanenv IMAGE.sif

    The PMACS host only needs its Singularity module. Do not load host R,
    GCC, HDF5, Python, or FFTW modules with this self-contained image.
