Bootstrap: docker
From: ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

%labels
    org.opencontainers.image.title "R spatial, single-cell, and sequencing analysis"
    org.opencontainers.image.description "Ubuntu 24.04 LTS, R 4.6.0, Bioconductor 3.23, Seurat 5.5.0, Arrow 24.0.0, HTSlib 1.24, glmGamPoi, scDblFinder, scCustomize, Cairo, and pinned dependencies"
    org.opencontainers.image.version "r4.6.0-seurat5.5.0-bioc3.23-htslib1.24"
    org.opencontainers.image.base.name "docker.io/library/ubuntu:24.04"
    org.opencontainers.image.base.digest "sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90"
    org.opencontainers.image.architecture "amd64"
    org.r-project.version "4.6.0"
    org.r-project.cran-snapshot "2026-06-01"
    org.bioconductor.version "3.23"
    org.bioconductor.snapshot "2026-07-22"
    org.htslib.version "1.24"

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl

    curl -fL --retry 5 --retry-delay 5 \
        -o /tmp/apache-arrow-apt-source_24.0.0-1_all.deb \
        https://packages.apache.org/artifactory/arrow/ubuntu/pool/noble/main/a/apache-arrow-apt-source/apache-arrow-apt-source_24.0.0-1_all.deb
    printf '%s  %s\n' \
        'e95437b98562d18bdf56ce87eed4d8a465ca8aeb5bd15800e1ffa430f6f139ac' \
        '/tmp/apache-arrow-apt-source_24.0.0-1_all.deb' | sha256sum -c -
    apt-get install -y --no-install-recommends \
        /tmp/apache-arrow-apt-source_24.0.0-1_all.deb
    printf '%s\n' \
        'Package: libarrow* libparquet*' \
        'Pin: version 24.0.0-1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/apache-arrow-24
    apt-get update

    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        file \
        fonts-dejavu-core \
        g++-12 \
        gcc-12 \
        gfortran-13 \
        git \
        libblas-dev \
        libbz2-dev \
        libcairo2-dev \
        libcurl4-openssl-dev \
        libdeflate-dev \
        libfftw3-dev \
        libfontconfig1-dev \
        libfreetype-dev \
        libfribidi-dev \
        libgdal-dev \
        libgeos-dev \
        libgfortran-13-dev \
        libgit2-dev \
        libglpk-dev \
        libgmp-dev \
        libgsl-dev \
        libharfbuzz-dev \
        libhdf5-dev \
        libicu-dev \
        libicu74 \
        libigraph-dev \
        libigraph3t64 \
        libjpeg-dev \
        liblapack-dev \
        liblzma-dev \
        libnghttp2-dev \
        libpango1.0-dev \
        libpcre2-dev \
        libpng-dev \
        libproj-dev \
        libreadline-dev \
        libsqlite3-dev \
        libssl-dev \
        libtiff-dev \
        libtool \
        libudunits2-dev \
        libuv1-dev \
        libwebp-dev \
        libx11-dev \
        libxml2-dev \
        libxt-dev \
        libarrow-dev=24.0.0-1 \
        libarrow-dataset-dev=24.0.0-1 \
        libarrow-acero-dev=24.0.0-1 \
        libarrow-flight-dev=24.0.0-1 \
        libparquet-dev=24.0.0-1 \
        make \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
        unzip \
        wget \
        xz-utils \
        zip \
        zlib1g-dev \
        gdal-bin

    for package in \
        libarrow-dev \
        libarrow-dataset-dev \
        libarrow-acero-dev \
        libarrow-flight-dev \
        libparquet-dev
    do
        test "$(dpkg-query -W -f='${Version}' "$package")" = '24.0.0-1'
    done

    mkdir -p /opt/src /opt/R/4.6.0 /opt/R/site-library /opt/container /opt/container-metadata/arrow-build-logs

    # Ubuntu 24.04's libhts-dev hard-depends on libcurl4-gnutls-dev,
    # which conflicts with the existing Arrow/OpenSSL development stack.
    # A verified upstream source build preserves that stack while installing
    # the complete system HTSlib runtime/development interface: libhts.so.3,
    # headers, static and unversioned libraries, htslib.pc, bgzip, htsfile,
    # and tabix.
    cd /opt/src
    curl -fL --retry 5 --retry-delay 5 \
        -o htslib-1.24.tar.bz2 \
        https://github.com/samtools/htslib/releases/download/1.24/htslib-1.24.tar.bz2
    printf '%s  %s\n' \
        '28a8de191381c7a97a35675ceac76fa1ea95e7b678d6a2e9d600a7874e4077de' \
        'htslib-1.24.tar.bz2' | sha256sum -c -
    tar -xf htslib-1.24.tar.bz2

    cd /opt/src/htslib-1.24
    CC=gcc-12 \
    CFLAGS='-O2 -pipe' \
        ./configure \
            --prefix=/usr/local \
            --enable-libcurl \
            --enable-s3 \
            --enable-gcs \
            --with-libdeflate
    make -j2
    make install
    ldconfig

    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig
    test -r /usr/local/include/htslib/hts.h
    test -e /usr/local/lib/libhts.so.3
    pkg-config --atleast-version=1.24 htslib
    test "$(pkg-config --modversion htslib)" = '1.24'
    test "$(pkg-config --modversion igraph)" = '0.10.10'

    cd /opt/src
    curl -fL --retry 5 --retry-delay 5 \
        -o R-4.6.0.tar.xz \
        https://cran.r-project.org/src/base/R-4/R-4.6.0.tar.xz
    printf '%s  %s\n' \
        '91f2b3693fa5252cdea9b62abc84a1c58db5547cb9f0fe3d15f44eef8aff5a27' \
        'R-4.6.0.tar.xz' | sha256sum -c -
    tar -xf R-4.6.0.tar.xz

    cd /opt/src/R-4.6.0
    CC=gcc-12 \
    CXX=g++-12 \
    CXX11=g++-12 \
    CXX14=g++-12 \
    CXX17=g++-12 \
    CXX20=g++-12 \
    FC=gfortran-13 \
    F77=gfortran-13 \
    CFLAGS='-O2 -pipe' \
    CXXFLAGS='-O2 -pipe' \
    FCFLAGS='-O2 -pipe' \
    FFLAGS='-O2 -pipe' \
        /bin/bash ./configure \
            --prefix=/opt/R/4.6.0 \
            --enable-R-shlib \
            --with-blas \
            --with-lapack \
            --with-x
    make -j2
    make install

    ln -sf /opt/R/4.6.0/bin/R /usr/local/bin/R
    ln -sf /opt/R/4.6.0/bin/Rscript /usr/local/bin/Rscript

    cat > /opt/container/install-r-packages.R <<'RSCRIPT'
    options(
      repos = c(CRAN = "https://packagemanager.posit.co/cran/2026-06-01"),
      BioC_mirror = "https://packagemanager.posit.co/bioconductor/2026-07-22",
      timeout = 1800,
      Ncpus = 2L,
      warn = 1
    )

    lib <- "/opt/R/site-library"
    dir.create(lib, recursive = TRUE, showWarnings = FALSE)
    .libPaths(c(lib, .libPaths()))

    cran_packages <- c(
      "BiocManager",
      "Cairo",
      "tidyverse",
      "future",
      "sp",
      "dplyr",
      "ggplot2",
      "SeuratObject",
      "Seurat",
      "hdf5r",
      "sf",
      "scCustomize"
    )

    install.packages(
      cran_packages,
      lib = lib,
      type = "source",
      dependencies = NA,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    Sys.setenv(
      LIBARROW_BINARY = "false",
      LIBARROW_BUILD = "false",
      ARROW_USE_PKG_CONFIG = "true",
      ARROW_R_DEV = "true",
      PKG_CONFIG_PATH = "/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig",
      CMAKE_BUILD_PARALLEL_LEVEL = "2",
      MAKEFLAGS = "-j2"
    )

    install.packages(
      "arrow",
      lib = lib,
      type = "source",
      dependencies = NA,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    bioc_version <- "3.23"
    BiocManager::install(
      version = bioc_version,
      lib = lib,
      ask = FALSE,
      update = FALSE,
      type = "source"
    )
    stopifnot(as.character(BiocManager::version()) == bioc_version)

    BiocManager::install(
      "Rhtslib",
      version = bioc_version,
      lib = lib,
      ask = FALSE,
      update = FALSE,
      type = "source",
      dependencies = NA,
      Ncpus = 2L,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    BiocManager::install(
      c("glmGamPoi", "scDblFinder"),
      version = bioc_version,
      lib = lib,
      ask = FALSE,
      update = FALSE,
      type = "source",
      dependencies = NA,
      Ncpus = 2L,
      INSTALL_opts = c("--no-multiarch", "--clean")
    )

    expected_exact <- c(
      BiocManager = "1.30.27",
      Cairo = "1.7-0",
      tidyverse = "2.0.0",
      sf = "1.1-1",
      arrow = "24.0.0",
      hdf5r = "1.3.12",
      ggplot2 = "4.0.3",
      Seurat = "5.5.0",
      SeuratObject = "5.4.0",
      sp = "2.2-1",
      dplyr = "1.2.1",
      future = "1.70.0",
      scCustomize = "3.3.0"
    )

    expected_bioc <- c(
      glmGamPoi = "1.24.0",
      Rhtslib = "3.8.0",
      scDblFinder = "1.26.7"
    )

    stopifnot(as.character(getRversion()) == "4.6.0")
    stopifnot(as.character(BiocManager::version()) == bioc_version)

    actual_exact <- vapply(names(expected_exact), function(pkg) {
      as.character(utils::packageVersion(pkg, lib.loc = lib))
    }, character(1))

    if (!identical(unname(actual_exact), unname(expected_exact))) {
      print(data.frame(
        package = names(expected_exact),
        expected = unname(expected_exact),
        actual = unname(actual_exact)
      ))
      stop("Top-level R package version gate failed")
    }

    actual_bioc <- vapply(names(expected_bioc), function(pkg) {
      as.character(utils::packageVersion(pkg, lib.loc = lib))
    }, character(1))

    if (!identical(unname(actual_bioc), unname(expected_bioc))) {
      print(data.frame(
        package = names(expected_bioc),
        expected = unname(expected_bioc),
        actual = unname(actual_bioc)
      ))
      stop("Bioconductor 3.23 package version gate failed")
    }

    installed <- as.data.frame(installed.packages(), stringsAsFactors = FALSE)
    installed <- installed[order(installed$Package), , drop = FALSE]
    write.table(
      installed,
      file = "/opt/container-metadata/r-packages.tsv",
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )
    capture.output(sessionInfo(), file = "/opt/container-metadata/r-session-info.txt")
    writeLines(
      as.character(BiocManager::version()),
      con = "/opt/container-metadata/bioconductor-version.txt"
    )
RSCRIPT

    export PATH=/opt/R/4.6.0/bin:/usr/local/bin:/usr/bin:/bin
    export R_HOME=/opt/R/4.6.0/lib/R
    export R_LIBS_SITE=/opt/R/site-library
    export R_LIBS_USER=
    export MAKEFLAGS=-j2
    /opt/R/4.6.0/bin/Rscript --vanilla /opt/container/install-r-packages.R

    cat > /opt/container/validate.R <<'RSCRIPT'
    options(warn = 1)
    .libPaths(c("/opt/R/site-library", .libPaths()))

    expected_exact <- c(
      BiocManager = "1.30.27",
      Cairo = "1.7-0",
      tidyverse = "2.0.0",
      sf = "1.1-1",
      arrow = "24.0.0",
      hdf5r = "1.3.12",
      ggplot2 = "4.0.3",
      Seurat = "5.5.0",
      SeuratObject = "5.4.0",
      sp = "2.2-1",
      dplyr = "1.2.1",
      future = "1.70.0",
      scCustomize = "3.3.0"
    )

    expected_bioc <- c(
      glmGamPoi = "1.24.0",
      Rhtslib = "3.8.0",
      scDblFinder = "1.26.7"
    )

    stopifnot(as.character(getRversion()) == "4.6.0")
    stopifnot(as.character(BiocManager::version()) == "3.23")

    actual_exact <- vapply(names(expected_exact), function(pkg) {
      as.character(utils::packageVersion(pkg))
    }, character(1))
    stopifnot(identical(unname(actual_exact), unname(expected_exact)))

    actual_bioc <- vapply(names(expected_bioc), function(pkg) {
      as.character(utils::packageVersion(pkg))
    }, character(1))
    stopifnot(identical(unname(actual_bioc), unname(expected_bioc)))

    suppressPackageStartupMessages({
      library(Cairo)
      library(sf)
      library(arrow)
      library(hdf5r)
      library(ggplot2)
      library(Seurat)
      library(future)
      library(dplyr)
      library(glmGamPoi)
      library(Rhtslib)
      library(scDblFinder)
      library(scCustomize)
    })

    point <- sf::st_sfc(sf::st_point(c(-75, 40)), crs = 4326)
    projected <- sf::st_transform(point, 3857)
    stopifnot(all(is.finite(sf::st_coordinates(projected))))

    parquet_file <- tempfile(fileext = ".parquet")
    arrow::write_parquet(
      data.frame(group = c("a", "a", "b"), value = 1:3),
      parquet_file
    )
    parquet_roundtrip <- as.data.frame(arrow::read_parquet(parquet_file))
    stopifnot(nrow(parquet_roundtrip) == 3L, sum(parquet_roundtrip$value) == 6)
    dataset_result <- arrow::open_dataset(parquet_file) |>
      dplyr::group_by(group) |>
      dplyr::summarise(total = sum(value)) |>
      dplyr::collect()
    stopifnot(sum(dataset_result$total) == 6)
    unlink(parquet_file)

    h5_file <- tempfile(fileext = ".h5")
    h5 <- hdf5r::H5File$new(h5_file, mode = "w")
    h5[["values"]] <- as.integer(1:5)
    h5_values <- h5[["values"]][]
    h5$close_all()
    stopifnot(identical(as.integer(h5_values), 1:5))
    unlink(h5_file)

    plot_file <- tempfile(fileext = ".png")
    plot_object <- ggplot2::ggplot(
      data.frame(x = 1:3, y = c(1, 4, 2)),
      ggplot2::aes(x, y)
    ) + ggplot2::geom_line()
    ggplot2::ggsave(plot_file, plot_object, width = 4, height = 3, dpi = 72)
    stopifnot(file.exists(plot_file), file.info(plot_file)$size > 0)
    unlink(plot_file)

    cairo_file <- tempfile(fileext = ".png")
    Cairo::CairoPNG(
      filename = cairo_file,
      width = 320,
      height = 240,
      bg = "white"
    )
    graphics::plot(1:5, (1:5)^2, type = "b")
    grDevices::dev.off()
    stopifnot(file.exists(cairo_file), file.info(cairo_file)$size > 0)
    unlink(cairo_file)

    set.seed(11)
    gamma_poisson_counts <- matrix(
      stats::rnbinom(8 * 12, mu = 5, size = 2),
      nrow = 8,
      ncol = 12
    )
    gamma_poisson_fit <- glmGamPoi::glm_gp(
      gamma_poisson_counts,
      design = ~ 1,
      on_disk = FALSE
    )
    stopifnot(
      nrow(gamma_poisson_fit$Beta) == nrow(gamma_poisson_counts),
      length(gamma_poisson_fit$overdispersions) ==
        nrow(gamma_poisson_counts)
    )

    rhtslib_hts_version <- trimws(capture.output(
      Rhtslib:::htsVersion(),
      type = "message"
    ))
    stopifnot(
      identical(rhtslib_hts_version, "1.18"),
      file.exists(system.file(
        "usrlib",
        "libhts.a",
        package = "Rhtslib"
      )),
      nzchar(paste(capture.output(
        Rhtslib::pkgconfig("PKG_CPPFLAGS")
      ), collapse = ""))
    )

    stopifnot(
      is.function(getExportedValue("scDblFinder", "scDblFinder")),
      is.function(getExportedValue("scCustomize", "DimPlot_scCustom"))
    )

    set.seed(123)
    doublet_sce <- scDblFinder::mockDoubletSCE(
      dbl.rate = 0.1,
      ngenes = 300
    )
    doublet_sce <- suppressMessages(scDblFinder::scDblFinder(
      doublet_sce,
      dbr = 0.1
    ))
    stopifnot(all(
      doublet_sce$scDblFinder.class %in% c("singlet", "doublet")
    ))

    set.seed(1)
    counts <- matrix(stats::rpois(40 * 20, lambda = 5), nrow = 40, ncol = 20)
    rownames(counts) <- sprintf("gene_%02d", seq_len(nrow(counts)))
    colnames(counts) <- sprintf("cell_%02d", seq_len(ncol(counts)))
    object <- Seurat::CreateSeuratObject(counts = counts)
    object <- Seurat::NormalizeData(object, verbose = FALSE)
    object <- Seurat::FindVariableFeatures(object, nfeatures = 20, verbose = FALSE)
    object <- Seurat::ScaleData(
      object,
      features = Seurat::VariableFeatures(object),
      verbose = FALSE
    )
    object <- Seurat::RunPCA(
      object,
      features = Seurat::VariableFeatures(object),
      npcs = 5,
      verbose = FALSE
    )
    stopifnot(ncol(Seurat::Embeddings(object, reduction = "pca")) == 5L)

    previous_plan <- future::plan(future::sequential)
    result <- future::value(future::future(40 + 2))
    future::plan(previous_plan)
    stopifnot(identical(result, 42))

    cat("Validated OS:\n")
    cat(readLines("/etc/os-release"), sep = "\n")
    cat("\nValidated exact R package versions:\n")
    print(
      data.frame(package = names(expected_exact), version = actual_exact),
      row.names = FALSE
    )
    cat("\nValidated Bioconductor 3.23 package versions:\n")
    print(
      data.frame(package = names(expected_bioc), version = actual_bioc),
      row.names = FALSE
    )
    cat("\nBioconductor release:\n")
    print(BiocManager::version())
    cat("\nRhtslib bundled HTSlib version:\n")
    cat(rhtslib_hts_version, "\n")
    cat("\nsf external libraries:\n")
    print(sf::sf_extSoftVersion())
    cat("\nHDF5 version:\n")
    print(hdf5r::h5version())
    cat("\nArrow build information:\n")
    print(arrow::arrow_info())
    cat("\nAll container validation checks passed.\n")
RSCRIPT

    cat > /opt/container/validate-system.sh <<'SH'
#!/bin/sh
set -eu

export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig

test -r /usr/include/igraph/igraph.h
test -r /usr/local/include/htslib/hts.h
test -e /usr/local/lib/libhts.so.3

test "$(pkg-config --modversion igraph)" = "0.10.10"
test "$(pkg-config --modversion htslib)" = "1.24"

for pc_module in \
    cairo \
    fontconfig \
    freetype2 \
    igraph \
    htslib \
    libdeflate \
    libjpeg \
    liblzma \
    libpng \
    libtiff-4 \
    libwebp \
    libwebpmux \
    zlib
do
    pkg-config --exists "$pc_module"
done

readelf -d /usr/local/lib/libhts.so |
    grep -Fq 'Library soname: [libhts.so.3]'

validation_tmp_dir="$(mktemp -d)"
trap 'rm -rf "$validation_tmp_dir"' EXIT HUP INT TERM

cat > "$validation_tmp_dir/test-htslib.c" <<'C_SOURCE'
#include <htslib/hts.h>

int main(void) {
    const char *version = hts_version();
    return version != 0 && version[0] != '\0' ? 0 : 1;
}
C_SOURCE

gcc-12 \
    $(pkg-config --cflags htslib) \
    "$validation_tmp_dir/test-htslib.c" \
    -o "$validation_tmp_dir/test-htslib" \
    $(pkg-config --libs htslib)
"$validation_tmp_dir/test-htslib"

cat > "$validation_tmp_dir/test-igraph.c" <<'C_SOURCE'
#include <igraph/igraph.h>

int main(void) {
    igraph_t graph;
    igraph_error_t status = igraph_ring(
        &graph, 5, IGRAPH_UNDIRECTED, 0, 1
    );
    if (status != IGRAPH_SUCCESS) {
        return 1;
    }
    igraph_destroy(&graph);
    return 0;
}
C_SOURCE

gcc-12 \
    $(pkg-config --cflags igraph) \
    "$validation_tmp_dir/test-igraph.c" \
    -o "$validation_tmp_dir/test-igraph" \
    $(pkg-config --libs igraph)
"$validation_tmp_dir/test-igraph"

/usr/local/bin/htsfile --version
printf 'System-library validation checks passed.\n'
SH

    chmod 0555 \
        /opt/container/install-r-packages.R \
        /opt/container/validate.R \
        /opt/container/validate-system.sh

    dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort \
        > /opt/container-metadata/debian-packages.tsv
    {
        printf 'R: '
        /opt/R/4.6.0/bin/R --version | head -n 1
        printf 'gcc: '
        gcc-12 --version | head -n 1
        printf 'g++: '
        g++-12 --version | head -n 1
        printf 'gfortran: '
        gfortran-13 --version | head -n 1
        printf 'python: '
        python3 --version
        printf 'fftw: '
        pkg-config --modversion fftw3
        printf 'hdf5: '
        pkg-config --modversion hdf5
        printf 'arrow-cpp: '
        pkg-config --modversion arrow
        printf 'parquet-cpp: '
        pkg-config --modversion parquet
        printf 'gdal: '
        gdal-config --version
        printf 'geos: '
        geos-config --version
        printf 'proj: '
        pkg-config --modversion proj
        printf 'cairo: '
        pkg-config --modversion cairo
        printf 'igraph-system: '
        pkg-config --modversion igraph
        printf 'htslib-system: '
        pkg-config --modversion htslib
        printf 'libdeflate: '
        pkg-config --modversion libdeflate
    } > /opt/container-metadata/toolchain-versions.txt

    system_validation_log=/opt/container-metadata/system-validation.txt
    if ! /opt/container/validate-system.sh \
        > "$system_validation_log" 2>&1
    then
        cat "$system_validation_log"
        exit 1
    fi
    cat "$system_validation_log"

    r_validation_log=/opt/container-metadata/build-validation.txt
    if ! R_LIBS_SITE=/opt/R/site-library \
        /opt/R/4.6.0/bin/Rscript --vanilla /opt/container/validate.R \
        > "$r_validation_log" 2>&1
    then
        cat "$r_validation_log"
        exit 1
    fi
    cat "$r_validation_log"

    apt-get clean
    find /var/lib/apt/lists -type f -delete
    find /opt/src -mindepth 1 -delete

%environment
    export PATH=/opt/R/4.6.0/bin:/usr/local/bin:/usr/bin:/bin
    export R_HOME=/opt/R/4.6.0/lib/R
    export R_LIBS_SITE=/opt/R/site-library
    export R_LIBS_USER=
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export R_MAX_NUM_DLLS=1000
    export PYTHONNOUSERSITE=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export CC=gcc-12
    export CXX=g++-12
    export FC=gfortran-13
    export F77=gfortran-13
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig

%runscript
    exec /opt/R/4.6.0/bin/R "$@"

%test
    set -eu
    export R_HOME=/opt/R/4.6.0/lib/R
    export R_LIBS_SITE=/opt/R/site-library
    export R_LIBS_USER=
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export R_MAX_NUM_DLLS=1000
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig
    /opt/container/validate-system.sh
    /opt/R/4.6.0/bin/Rscript --vanilla /opt/container/validate.R

%help
    This amd64 image contains Ubuntu 24.04 LTS, R 4.6.0,
    Bioconductor 3.23, HTSlib 1.24, and the pinned spatial,
    single-cell, and sequencing-analysis stack requested for PMACS.
    CRAN packages use the 2026-06-01 snapshot and Bioconductor packages
    use the 2026-07-22 snapshot.

    HTSlib 1.24 is installed under /usr/local and provides libhts.so.3,
    development headers, pkg-config metadata, bgzip, htsfile, and tabix.
    Rhtslib separately provides its bundled HTSlib 1.18 to R packages.

    Validate:
      singularity test --cleanenv IMAGE.sif

    Run an R script:
      singularity exec --cleanenv IMAGE.sif Rscript analysis.R

    Start R:
      singularity run --cleanenv IMAGE.sif

    The PMACS host only needs its Singularity module. Do not load host R,
    GCC, HDF5, Python, or FFTW modules with this self-contained image.
